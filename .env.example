# Replace placeholders locally; never commit actual credentials.
AI_JUDGE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_judge
AI_JUDGE_DB_POOL_SIZE=5
AI_JUDGE_DB_MAX_OVERFLOW=5
AI_JUDGE_DB_POOL_TIMEOUT=10
AI_JUDGE_DB_CONNECT_TIMEOUT=5
AI_JUDGE_DB_STATEMENT_TIMEOUT_MS=10000

AI_JUDGE_PHASE1_MAX_BODY_BYTES=2000000
AI_JUDGE_PHASE1_MAX_IMPORT_RECORDS=1000

# GenAI is opt-in; configure an authorized Chat Completions compatible endpoint.
AI_JUDGE_GENAI_ENABLED=false
AI_JUDGE_GENAI_PROVIDER=openai_compatible
# AI_JUDGE_GENAI_BASE_URL=https://YOUR_PROVIDER/v1
# AI_JUDGE_GENAI_API_KEY=YOUR_KEY
# AI_JUDGE_GENAI_MODEL=YOUR_MODEL
AI_JUDGE_GENAI_TIMEOUT_SECONDS=30
AI_JUDGE_GENAI_TEMPERATURE=0.7
AI_JUDGE_GENAI_MAX_RESPONSE_BYTES=1000000
AI_JUDGE_GENAI_MAX_CONCURRENCY=2
# AI_JUDGE_GENAI_SYSTEM_PROMPT=Your versioned synthetic evaluation prompt
